# ── Core ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/cue
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Email (Resend) ─────────────────────────────────────
# Optional — email sending is best-effort and failures are swallowed.
RESEND_API_KEY=
RESEND_FROM=Cue <onboarding@resend.dev>
# Fallback recipient for contact-form messages (defaults to RESEND_FROM).
CONTACT_EMAIL=

# ── Tickets ────────────────────────────────────────────
# Minutes after which a waiting ticket is swept to skipped/no-show.
TICKET_NO_SHOW_MINUTES=5

# ── Superadmin / development seed data ─────────────────────
# npm run seed:superadmin creates only the platform operator.
# npm run seed:dev creates the full two-bank local test graph.
SEED_SUPERADMIN_NAME=Platform Superadmin
SEED_SUPERADMIN_EMAIL=superadmin@cue.dev
SEED_SUPERADMIN_PASSWORD=Superadmin@1234

# ── Optional admin seeding (seed:admin, local dev only) ─
# In production use POST /api/auth/register/admin instead.
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@queue.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_BANK=Example Bank
# Shared password for npm run seed:dev test accounts.
SEED_DEFAULT_PASSWORD=LocalTest@1234

# ── Optional API key seeding (seed:apikey, local dev) ──
# In production keys are created by the superadmin on /platform.
SEED_API_KEY_BANK_NAME=Example Bank
SEED_API_KEY_LABEL=Local Dev Key
SEED_API_KEY_RATE_LIMIT=1000

# ── Platform security ─────────────────────────────────
# Secret required in X-Admin-Registration-Secret for public admin onboarding.
ADMIN_REGISTRATION_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key for encrypting raw API keys staged for one-time
# bank-admin reveal. Falls back to JWT_SECRET if unset.
KEY_WRAP_SECRET=change-me-to-a-long-random-string

# ── Branding (env-only; no DB layer) ──────────────────
BRAND_NAME=Cue
BRAND_PRIMARY_COLOR=#0d7c66
BRAND_ACCENT_COLOR=#c9a227
BRAND_ALERT_COLOR=#dc2626
BRAND_SUPPORT_EMAIL=support@yourbank.com
BRAND_EMAIL_FROM=Cue
