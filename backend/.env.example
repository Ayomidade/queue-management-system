MONGO_URI=set-mongo-uri-here
JWT_SECRET=jwt_secret
JWT_EXPIRES_IN=jwt_expiration_time
PORT=server_port
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Cue <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173
TICKET_NO_SHOW_MINUTES=5 // Set the number of minutes after which a ticket is considered a no-show
CORS_ORIGIN=http://localhost:5173

# ── Seed defaults (seed:all) ──────────────────────────
SEED_BRANCH_NAME=Main Branch
SEED_BRANCH_LOCATION=Downtown
SEED_QUEUE_1=General Service
SEED_QUEUE_2=Priority Service
SEED_COUNTER_1=Counter 1
SEED_COUNTER_2=Counter 2
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@queue.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_MANAGER_NAME=Branch Manager
SEED_MANAGER_EMAIL=manager@queue.com
SEED_MANAGER_PASSWORD=Manager@1234
SEED_STAFF_NAME=Front Desk Staff
SEED_STAFF_EMAIL=staff@queue.com
SEED_STAFF_PASSWORD=Staff@1234
SEED_CUSTOMER_NAME=John Customer
SEED_CUSTOMER_EMAIL=customer@queue.com
SEED_CUSTOMER_PASSWORD=Customer@1234

# ── Superadmin seeding (seed:superadmin) ─────────────
SEED_SUPERADMIN_NAME=Platform Superadmin
SEED_SUPERADMIN_EMAIL=superadmin@cue.dev
SEED_SUPERADMIN_PASSWORD=Superadmin@1234

# ── Platform security ────────────────────────────────
# Used to AES-256-GCM-encrypt raw API keys staged for one-time bank-admin reveal.
# Falls back to JWT_SECRET if unset.
KEY_WRAP_SECRET=change-me-to-a-long-random-string

# 
# ── API Key Seeding ──────────────────────────────────────
SEED_API_KEY_BANK_NAME=System Admin
SEED_API_KEY_LABEL=System Admin Key
SEED_API_KEY_RATE_LIMIT=1000

# 
# ── Branding ───────────────────────────────────────────
BRAND_NAME=Cue
BRAND_PRIMARY_COLOR=#0d7c66
BRAND_ACCENT_COLOR=#c9a227
BRAND_ALERT_COLOR=#dc2626
BRAND_SUPPORT_EMAIL=support@yourbank.com
BRAND_EMAIL_FROM=Cue